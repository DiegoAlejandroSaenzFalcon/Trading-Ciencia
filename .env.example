# =============================================================================
# TRADING SCIENCE FRAMEWORK - CONFIGURACIÓN DE ENTORNO
# =============================================================================
# COPIA ESTE ARCHIVO A .env Y COMPLETA TUS VALORES REALES
# NUNCA COMMITEES .env AL REPOSITORIO (está en .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# OANDA v20 API (Forex/Metales - XAUUSD nativo, demo gratis)
# Obtén tus keys en: https://www.oanda.com/demo-account → My Account → API
# -----------------------------------------------------------------------------
OANDA_ACCOUNT_ID=your-demo-account-id-here
OANDA_API_KEY=your-demo-api-key-here
OANDA_ENVIRONMENT=practice  # "practice" (demo) o "live" (real)
OANDA_STREAMING_HOST=stream-fxpractice.oanda.com
OANDA_REST_HOST=api-fxpractice.oanda.com

# -----------------------------------------------------------------------------
# SÍMBOLOS Y TIMEFRAMES
# -----------------------------------------------------------------------------
DEFAULT_SYMBOL=XAUUSD
DEFAULT_TIMEFRAME=M5
ALTERNATIVE_SYMBOLS=BTCUSD,EURUSD,GBPUSD,USDJPY
SESSION_START_HOUR=13  # Hora servidor (UTC)
SESSION_END_HOUR=20

# -----------------------------------------------------------------------------
# BASE DE DATOS (SQLite para desarrollo, PostgreSQL para producción)
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/tsf.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/tsf

# -----------------------------------------------------------------------------
# REDIS (opcional - para caching, rate limiting, celery)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# MONITOREO Y ALERTAS
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# Telegram Bot (opcional - para alertas)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Discord Webhook (opcional - para alertas)
DISCORD_WEBHOOK_URL=your-webhook-url-here

# -----------------------------------------------------------------------------
# GOBERNANZA Y SEGURIDAD
# -----------------------------------------------------------------------------
GOV_POLICY_PATH=governance/policy.yml
GOV_LEDGER_PATH=governance/ledger.jsonl
REQUIRE_HUMAN_APPROVAL=true
ALLOW_LIVE_TRADING=false  # SOLO true tras validación demo extensiva

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json  # json o console
LOG_FILE=logs/tsf.log

# -----------------------------------------------------------------------------
# BACKTESTING / VALIDACIÓN
# -----------------------------------------------------------------------------
DEFAULT_N_SPLITS=12
DEFAULT_N_TEST_GROUPS=6
DEFAULT_PERIODS_PER_YEAR=252
DEFAULT_MIN_TRIALS=5

# -----------------------------------------------------------------------------
# EJECUCIÓN / RISK MANAGEMENT (VALORES DEMO CONSERVADORES)
# -----------------------------------------------------------------------------
DEFAULT_SIZING_MODE=2  # 0=fijo, 1=USD risk, 2=% equity
DEFAULT_RISK_PCT_EQUITY=0.5
DEFAULT_MAX_LOTS=1.0
DEFAULT_SL_MULT_ATR=1.5
DEFAULT_TP_R_MULTIPLE=2.0
DEFAULT_COOLDOWN_MINUTES=10
DEFAULT_MAX_TRADES_PER_DAY=5
DEFAULT_DAILY_LOSS_LIMIT_PCT=2.0

# -----------------------------------------------------------------------------
# KALMAN FILTER PARAMS (REFERENCIA HISTÓRICA - NO OBLIGATORIOS)
# -----------------------------------------------------------------------------
KALMAN_BARS=50
KALMAN_Q=0.05
KALMAN_R=0.30
EMA_PERIOD=30
SIGNAL_SMOOTHING=3

# -----------------------------------------------------------------------------
# VOLATILIDAD Y SPREAD FILTERS
# -----------------------------------------------------------------------------
ATR_PERIOD=14
MIN_VOL_POINTS=50.0
MAX_SPREAD_PCT_ATR=0.35

# -----------------------------------------------------------------------------
# MAGIC NUMBER (para identificación de órdenes)
# -----------------------------------------------------------------------------
MAGIC_NUMBER=482011