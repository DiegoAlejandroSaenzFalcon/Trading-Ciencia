{
  "dashboard": {
    "title": "Trading Science Framework - Overview",
    "uid": "tsf-overview",
    "tags": ["trading", "tsf", "overview"],
    "timezone": "utc",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Equity Curve",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "tsf_equity",
            "legendFormat": "Equity",
            "refId": "A"
          },
          {
            "expr": "tsf_balance",
            "legendFormat": "Balance",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2
          }
        }
      },
      {
        "id": 2,
        "title": "Drawdown %",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "tsf_drawdown_pct",
            "legendFormat": "Drawdown %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "color": {"mode": "thresholds", "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            }}
          }
        }
      },
      {
        "id": 3,
        "title": "Daily PnL",
        "type": "barchart",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "tsf_daily_pnl",
            "legendFormat": "Daily PnL",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2
          }
        }
      },
      {
        "id": 4,
        "title": "Win Rate / Avg R / Expectancy",
        "type": "stat",
        "gridPos": {"x": 12, "y": 8, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "tsf_win_rate",
            "legendFormat": "Win Rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 45},
                {"color": "green", "value": 55}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Avg R",
        "type": "stat",
        "gridPos": {"x": 16, "y": 8, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "tsf_avg_r",
            "legendFormat": "Avg R",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 0.5},
                {"color": "green", "value": 1.0}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Expectancy (R/trade)",
        "type": "stat",
        "gridPos": {"x": 20, "y": 8, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "tsf_expectancy",
            "legendFormat": "Expectancy",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 3,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 0.1},
                {"color": "green", "value": 0.2}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Trades Today / Daily Limit",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 16, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "tsf_trades_today",
            "legendFormat": "Trades Today",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "min": 0,
            "max": 5,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 4},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Daily Loss % / Breaker",
        "type": "gauge",
        "gridPos": {"x": 6, "y": 16, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "tsf_daily_loss_pct",
            "legendFormat": "Daily Loss %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "min": 0,
            "max": 3,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1.5},
                {"color": "red", "value": 2.0}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Open Positions",
        "type": "stat",
        "gridPos": {"x": 12, "y": 16, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "tsf_open_positions",
            "legendFormat": "Open Positions",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 2}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "OANDA Connection Status",
        "type": "stat",
        "gridPos": {"x": 16, "y": 16, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "tsf_oanda_connected",
            "legendFormat": "Connected",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "mappings": [
              {"type": "value", "options": {"0": {"text": "DISCONNECTED", "color": "red"}, "1": {"text": "CONNECTED", "color": "green"}}}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "API Latency (P95)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(tsf_oanda_api_latency_seconds_bucket[5m]))",
            "legendFormat": "P95 Latency",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(tsf_oanda_api_latency_seconds_bucket[5m]))",
            "legendFormat": "P50 Latency",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 3
          }
        }
      },
      {
        "id": 12,
        "title": "Order Rejection Rate",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(tsf_orders_rejected_total[5m]) / rate(tsf_orders_total[5m]) * 100",
            "legendFormat": "Rejection Rate %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2
          }
        }
      },
      {
        "id": 13,
        "title": "Slippage (pips)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 30, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "tsf_avg_slippage_pips",
            "legendFormat": "Avg Slippage",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 2
          }
        }
      },
      {
        "id": 14,
        "title": "Factor-QC Gate Status",
        "type": "stat",
        "gridPos": {"x": 12, "y": 30, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "tsf_factor_qc_gate_result",
            "legendFormat": "Gate Result",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "mappings": [
              {"type": "value", "options": {"0": {"text": "PASS", "color": "green"}, "1": {"text": "P0 BLOCK", "color": "red"}, "2": {"text": "ERROR", "color": "orange"}}}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 15,
        "title": "Governance Check Status",
        "type": "stat",
        "gridPos": {"x": 16, "y": 30, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "tsf_governance_check_result",
            "legendFormat": "Gov Check",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "mappings": [
              {"type": "value", "options": {"0": {"text": "RELEASE", "color": "green"}, "1": {"text": "REVIEW", "color": "yellow"}, "2": {"text": "BLOCK", "color": "red"}}}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 2}
              ]
            }
          }
        }
      },
      {
        "id": 16,
        "title": "Ledger Health",
        "type": "stat",
        "gridPos": {"x": 20, "y": 30, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "tsf_ledger_health_ok",
            "legendFormat": "Ledger OK",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "mappings": [
              {"type": "value", "options": {"0": {"text": "CORRUPTED", "color": "red"}, "1": {"text": "HEALTHY", "color": "green"}}}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      }
    ]
  }
}