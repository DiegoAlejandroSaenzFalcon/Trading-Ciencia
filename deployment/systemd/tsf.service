# Trading Science Framework - Systemd Service
#
# Instalación en VPS (como root):
#   cp deployment/systemd/tsf.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable tsf
#   systemctl start tsf
#   systemctl status tsf
#
# Logs: journalctl -u tsf -f

[Unit]
Description=Trading Science Framework - Scientific Trading Research Bot
Documentation=https://diegoalejandrosaenzfalcon.github.io/Trading-Ciencia/
After=network-online.target docker.service postgresql.service redis.service
Wants=network-online.target docker.service postgresql.service redis.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
# Usuario no-root (crear: useradd -r -s /bin/false -d /opt/tsf tsf)
User=tsf
Group=tsf
WorkingDirectory=/opt/tsf
EnvironmentFile=/opt/tsf/.env
Environment=TSF_ENV=production
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Comando principal - usar docker-compose para stack completo
ExecStartPre=/usr/bin/docker-compose -f /opt/tsf/docker-compose.yml -f /opt/tsf/docker-compose.prod.yml pull
ExecStart=/usr/bin/docker-compose -f /opt/tsf/docker-compose.yml -f /opt/tsf/docker-compose.prod.yml up --remove-orphans
ExecStop=/usr/bin/docker-compose -f /opt/tsf/docker-compose.yml -f /opt/tsf/docker-compose.prod.yml down --remove-orphans
ExecReload=/usr/bin/docker-compose -f /opt/tsf/docker-compose.yml -f /opt/tsf/docker-compose.prod.yml restart

# Reinicio automático
Restart=on-failure
RestartSec=30
TimeoutStartSec=120
TimeoutStopSec=60

# Límites de recursos (ajustar según VPS)
MemoryLimit=2G
CPUQuota=200%
TasksMax=1000

# Seguridad
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/tsf/data /opt/tsf/research /opt/tsf/lessons /opt/tsf/governance /opt/tsf/logs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tsf

[Install]
WantedBy=multi-user.target